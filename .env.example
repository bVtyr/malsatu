# ---------- Общие ----------
NODE_ENV=development
APP_NAME=MalSatu
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000

# ---------- База данных (PostgreSQL 16 + PostGIS) ----------
DATABASE_URL=postgres://malsatu:malsatu@localhost:5432/malsatu

# ---------- Redis (очереди, rate-limit, кэш) ----------
REDIS_URL=redis://localhost:6379

# ---------- Хранилище медиа (S3-совместимое, MinIO локально) ----------
S3_ENDPOINT=http://localhost:9000
S3_REGION=kz-1
S3_BUCKET=malsatu-media
S3_ACCESS_KEY=malsatu
S3_SECRET_KEY=malsatu123
S3_PUBLIC_URL=http://localhost:9000/malsatu-media

# ---------- Аутентификация ----------
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_DAYS=30
OTP_TTL_SECONDS=300
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
# В dev-режиме код не отправляется, а печатается в лог и равен 111111 для сидовых номеров
OTP_DEV_STATIC_CODE=111111

# ---------- SMS / мессенджеры (провайдер: mock | smsc | mobizon | kazinfoteh) ----------
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_SENDER=MalSatu

# ---------- Подменные номера (провайдер: mock | zadarma | twilio) ----------
CALL_MASKING_PROVIDER=mock
CALL_MASKING_API_KEY=

# ---------- Платёжный партнёр (v2): mock | kaspi | paybox | cloudpayments ----------
PAYMENT_PROVIDER=mock
PAYMENT_MERCHANT_ID=
PAYMENT_SECRET=

# ---------- Карты ----------
MAP_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
GEOCODER_PROVIDER=nominatim

# ---------- Госсервисы (v2): верификация ИИН/БИН, база идентификации животных ----------
GOV_VERIFY_PROVIDER=mock
GOV_VERIFY_API_KEY=
ANIMAL_ID_DB_PROVIDER=mock

# ---------- Автоперевод kk<->ru: mock | deepl | google | yandex ----------
TRANSLATE_PROVIDER=mock
TRANSLATE_API_KEY=

# ---------- Push (Web Push VAPID) ----------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@malsatu.kz

# ---------- Наблюдаемость ----------
SENTRY_DSN=
LOG_LEVEL=info

# Секрет вебхука телефонии (заголовок x-webhook-secret), обязателен в production
CALL_WEBHOOK_SECRET=
