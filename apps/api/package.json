{
  "name": "@malsatu/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "start": "tsx src/server.ts",
    "migrate": "tsx src/db/migrate.ts up",
    "migrate:reset": "tsx src/db/migrate.ts reset",
    "seed": "tsx src/seed.ts",
    "jobs": "tsx src/jobs/runner.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo 'lint: ok'"
  },
  "dependencies": {
    "@malsatu/shared": "workspace:*",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "@fastify/websocket": "^11.0.1",
    "@fastify/multipart": "^9.0.1",
    "@fastify/swagger": "^9.2.0",
    "@fastify/swagger-ui": "^5.1.0",
    "@aws-sdk/client-s3": "^3.670.0",
    "@aws-sdk/s3-request-presigner": "^3.670.0",
    "fastify": "^5.0.0",
    "fastify-plugin": "^5.0.1",
    "ioredis": "^5.4.1",
    "kysely": "^0.27.4",
    "pg": "^8.13.0",
    "pino": "^9.5.0",
    "tsx": "^4.19.1",
    "ws": "^8.18.0",
    "sharp": "^0.33.5",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.5.12",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
